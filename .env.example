# Public server
PORT=8080
HOST=0.0.0.0
PUBLIC_ORIGIN=https://live.tokenresearch.com.cn
PUBLIC_MODEL_LABEL=ChatGPT
STATE_FILE=runtime/monitor-state.json
RUN_ON_START=true

# Candy: OpenAI-compatible Responses API. Keep these only on the server.
OPENAI_BASE_URL=https://your-base-url.example/v1
OPENAI_API_KEY=replace-me
CANDY_MODEL=replace-me
CANDY_REASONING_EFFORT=
CANDY_TIMEOUT_MS=480000
CANDY_MAX_OUTPUT_TOKENS=4096

# Pelican: one real generation every 30 min. Choose command OR http adapter.
# command mode: stdin receives the exact pelican prompt; executor must create index.html in cwd.
PELICAN_EXEC_MODE=command
CODEX_EXEC_COMMAND_JSON=["codex","exec","-"]
CODEX_EXEC_TIMEOUT_MS=720000

# http mode alternative. POST receives {prompt, output_file}; response may be {html} or {files:{"index.html":"..."}}.
# PELICAN_EXEC_MODE=http
# CODEX_EXEC_URL=https://your-executor.example/run
# CODEX_EXEC_KEY=replace-me

# Optional limits
CANDY_HISTORY_LIMIT=1000
PELICAN_HISTORY_LIMIT=100
